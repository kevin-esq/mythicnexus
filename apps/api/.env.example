# Copy this file to `apps/api/.env` (same folder as this example) and fill in values.
# Never commit `.env`.

# --- PostgreSQL (Supabase) — users & tenants register HERE (not Supabase Auth) ---
# Dashboard → Project Settings → Database → Connection string (URI or parameters).
# Database name is usually `postgres`. Use SSL.
#
# Run API against Supabase DB (no local Docker Postgres):
#   dotnet run --project apps/api/src/MythicNexus.Api --launch-profile Supabase
# Or set: ASPNETCORE_ENVIRONMENT=Supabase
#
# Then apply migrations once (from repo root):
#   $env:ASPNETCORE_ENVIRONMENT="Supabase"
#   dotnet ef database update --project apps/api/src/MythicNexus.Infrastructure/MythicNexus.Infrastructure.csproj --startup-project apps/api/src/MythicNexus.Api/MythicNexus.Api.csproj
ConnectionStrings__Default=Host=db.PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Transaction pooler (optional, port 6543) — see Supabase “Connection pooling” docs if you prefer pooler hostnames.

# JWT signing (override appsettings). Must be at least 32 characters for HS256.
# Jwt__Issuer=MythicNexus
# Jwt__Audience=MythicNexus.Web
# Jwt__SecretKey=your-production-secret-at-least-32-chars-long
# Jwt__AccessTokenExpirationMinutes=60

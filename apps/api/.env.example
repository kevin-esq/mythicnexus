# Copy this file to `.env` and fill in real values (never commit `.env`).

# Recommended: Npgsql connection string (replace PROJECT_REF and Database if needed).
# Supabase Reference ID: Dashboard → Settings → General.
ConnectionStrings__Default=Host=db.PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Optional: adjust Host/Port/Username for pooler or custom hosts per Supabase dashboard.
